<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: nothing is backed up (incident data, contacts and the Keystore-wrapped
     server credential must not leave the device; allowBackup is also false). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
